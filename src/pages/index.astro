---
import { Link } from '@cloudflare/kumo/components/link';
import { Text } from '@cloudflare/kumo/components/text';
import Base from '../layouts/Base.astro';
import { publishedArticles, dateLabel, articleUrl } from '../lib/articles';

const articles = await publishedArticles();
---
<Base>
  <section aria-labelledby="latest-heading">
    <div class="section-heading"><h1 id="latest-heading">新着記事</h1></div>
    {articles.length ? (
      <ol class="article-list">
        {articles.map(article => (
          <li>
            <article>
              <time datetime={article.data.publishedAt.toISOString()}>{dateLabel(article.data.publishedAt)}</time>
              <h2><Link href={articleUrl(article.id)}>{article.data.title}</Link></h2>
              <Text variant="secondary">{article.data.summary}</Text>
            </article>
          </li>
        ))}
      </ol>
    ) : <Text variant="secondary" DANGEROUS_className="empty">公開された記事はまだありません。</Text>}
  </section>
</Base>

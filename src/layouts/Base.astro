---
import { Link } from '@cloudflare/kumo/components/link';
import '../styles/global.css';
import { Text } from '@cloudflare/kumo/components/text';

interface Props { title?: string; description?: string }
const { title = 'bado.info', description = 'バドミントンのニュースと考察。' } = Astro.props;
const isHome = Astro.url.pathname === '/';
const isAbout = Astro.url.pathname === '/about/';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title === 'bado.info' ? title : `${title} | bado.info`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="bado.info" href="/rss.xml" />
  </head>
  <body>
    <Link className="skip" href="#main">本文へ移動</Link>
    <header class="masthead shell">
      <Link className="wordmark" href="/">bado.info</Link>
      <nav class="site-nav" aria-label="メインナビゲーション">
        <Link href="/" aria-current={isHome ? 'page' : undefined}>記事</Link>
        <Link href="/about/" aria-current={isAbout ? 'page' : undefined}>このサイトについて</Link>
        <Link href="/rss.xml">RSS</Link>
      </nav>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="site-footer shell">
      <Text as="span" DANGEROUS_className="footer-name">bado.info</Text>
      <Link href="/about/">運営方針</Link>
    </footer>
  </body>
</html>

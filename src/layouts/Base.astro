---
import '../styles/global.css';

interface Props { title?: string; description?: string }
const { title = 'bado.info', description = 'バドミントンのニュースと考察。' } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title === 'bado.info' ? title : `${title} | bado.info`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="bado.info" href="/rss.xml" />
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">bado.info</a>
        <nav aria-label="メインナビゲーション">
          <a href="/about/">このサイトについて</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="shell site-footer"><a href="/">bado.info</a></footer>
  </body>
</html>

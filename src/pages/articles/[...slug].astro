---
import { Link } from '@cloudflare/kumo/components/link';
import { render } from 'astro:content';
import { Text } from '@cloudflare/kumo/components/text';
import Base from '../../layouts/Base.astro';
import { publishedArticles, dateLabel } from '../../lib/articles';

export async function getStaticPaths() {
  return (await publishedArticles()).map(article => ({
    params: { slug: article.id }, props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---
<Base title={article.data.title} description={article.data.summary}>
  <article class="reading">
    <Link className="back-link" href="/">記事一覧へ</Link>
    <header class="article-header">
      <p class="meta">
        <time datetime={article.data.publishedAt.toISOString()}>{dateLabel(article.data.publishedAt)}</time>
        {article.data.updatedAt && <span>
          更新 <time datetime={article.data.updatedAt.toISOString()}>{dateLabel(article.data.updatedAt)}</time>
        </span>}
      </p>
      <h1>{article.data.title}</h1>
      <Text variant="secondary" DANGEROUS_className="article-summary">{article.data.summary}</Text>
    </header>
    <div class="prose"><Content /></div>
    {article.data.sources.length > 0 && (
      <section class="sources" aria-labelledby="sources-heading">
        <h2 id="sources-heading">出典</h2>
        <ul>{article.data.sources.map(source => <li><Link href={source.url}>{source.title}</Link></li>)}</ul>
      </section>
    )}
  </article>
</Base>

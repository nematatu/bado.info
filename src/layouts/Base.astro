---
import '../styles/global.css';

interface Props { title?: string; description?: string }
const { title = 'bado.info', description = 'バドミントンのニュースと考察。' } = Astro.props;
const isHome = Astro.url.pathname === '/';
const isAbout = Astro.url.pathname === '/about/';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title === 'bado.info' ? title : `${title} | bado.info`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="bado.info" href="/rss.xml" />
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <header class="masthead shell">
      <a class="wordmark" href="/">bado.info</a>
      <nav class="site-nav" aria-label="メインナビゲーション">
        <a href="/" aria-current={isHome ? 'page' : undefined}>記事</a>
        <a href="/about/" aria-current={isAbout ? 'page' : undefined}>このサイトについて</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="site-footer shell">
      <span class="footer-name">bado.info</span>
      <a href="/about/">運営方針</a>
    </footer>
  </body>
</html>
